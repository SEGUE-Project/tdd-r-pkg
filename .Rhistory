integrated <- data.frame(
group_a = c(10, 20),
group_b = c(10, 20)
)
test_that("identical distributions give D = 0", {
integrated <- data.frame(
group_a = c(10, 20),
group_b = c(10, 20)
)
expect_equal(dissim(integrated), 0)
})
library(testthat)
test_that("identical distributions give D = 0", {
integrated <- data.frame(
group_a = c(10, 20),
group_b = c(10, 20)
)
expect_equal(dissim(integrated), 0)
